# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------------------------------------------------------
# Secrets / credentials  (NEVER commit)
# ---------------------------------------------------------------------------
# Quay.io credentials
.quay.env
*.env
# SSH / TLS private keys (EC2 key pair auto-generated by 00-vpc)
*.pem
*.key
id_rsa*
*.p12
*.pfx
# Generic credential files
**/credentials
*.kubeconfig
kubeconfig*

# Generated WEKA manifests (backend IPs + base64-encoded admin password)
manifests/weka/core/weka-client.yaml
manifests/weka/core/csi-wekafs-api-secret.yaml

# ---------------------------------------------------------------------------
# Benchmark output (raw per-run tables; curated BENCHMARK-RESULTS.md is tracked)
# ---------------------------------------------------------------------------
results/*.md

# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
*.swp
*~
