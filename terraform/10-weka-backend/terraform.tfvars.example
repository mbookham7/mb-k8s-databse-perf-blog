# Copy to terraform.tfvars and fill in the required values.
# Subnets come automatically from the 00-vpc layer's remote state — do not set them here.

region = "us-west-2"

tags_map = { Project = "pg-weka-bench" }

# -----------------------------------------------------------------------------
# Cluster  (cluster_name must match the value used in 00-vpc and 20-eks)
# -----------------------------------------------------------------------------
cluster_name = "pg-weka-bench"
cluster_size = 6 # WEKA minimum; cannot go lower
prefix       = "weka"

# -----------------------------------------------------------------------------
# Instance (cost-optimized demo sizing)
# -----------------------------------------------------------------------------
instance_type    = "i3en.2xlarge"
assign_public_ip = false
# key_pair_name is auto-generated by the 00-vpc layer; leave unset to use it.
# Set it explicitly only if you want to use a pre-existing key pair.

# -----------------------------------------------------------------------------
# WEKA Software  (token from https://get.weka.io)
# -----------------------------------------------------------------------------
weka_version      = "4.4.21.2"
get_weka_io_token = "REPLACE_WITH_GET_WEKA_IO_TOKEN"

# -----------------------------------------------------------------------------
# ALB (web UI / API). Second subnet is supplied automatically from 00-vpc.
# -----------------------------------------------------------------------------
create_alb = true

# -----------------------------------------------------------------------------
# Network / Secrets Manager
# The 00-vpc layer provides a NAT gateway, so backends reach Secrets Manager
# over the internet — no VPC endpoint required.
# -----------------------------------------------------------------------------
create_nat_gateway                = false
secretmanager_use_vpc_endpoint    = false
secretmanager_create_vpc_endpoint = false
